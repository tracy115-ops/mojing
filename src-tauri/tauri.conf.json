{
  "productName": "MoJing",
  "version": "0.1.3",
  "identifier": "com.mojing.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MoJing - 墨境",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' tauri: asset:; img-src 'self' data: blob: https: http: asset: http://asset.localhost https://asset.localhost; media-src 'self' data: blob: https: http: asset: http://asset.localhost https://asset.localhost; connect-src 'self' ipc: http://ipc.localhost https: http: wss: ws:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'",
      "dangerousDisableAssetCspModification": true,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCAL/**",
          "$TEMP/**",
          "$HOME/**",
          "$DOWNLOAD/**",
          "$DOCUMENT/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright 2026 MoJing",
    "category": "Productivity",
    "shortDescription": "MoJing 墨境 — AI 创意工作站",
    "longDescription": "MoJing（墨境）是一款 AI 驱动的创意工作站，集成小说引擎、漫画工坊和视频工坊，提供从文字到画面的完整创作流水线。",
    "windows": {
      "nsis": null,
      "digestAlgorithm": "sha256",
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
